# PlayHub 部署配置示例
# 复制为 .env 后按需修改：cp .env.example .env

# 对外端口
APP_PORT=18080

# 时区
TZ=Asia/Shanghai

# 管理员账号（仅首次启动创建；已存在不会重置密码）
APP_ADMIN_ENABLED=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=playhub

# 爬虫并发（小内存机器建议保持 2）
APP_SPIDER_OPERATION_MAX_CONCURRENCY=2
APP_SCRIPT_MAX_CONCURRENCY=2

# 跨站兜底桥（默认关闭；开启会返回「别的站」的内容，与自身片源不一致）
SPIDER_BRIDGE_URL=
